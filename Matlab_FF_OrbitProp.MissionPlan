  <ProjectMissionSequence>
    <ProjectExternals />
    <ProjectCommands>
      <FreeForm enabled="true">
        <Label>Main Code</Label>
        <Bookmarks />
        <Breakpoints />
        <FreeFormScript><![CDATA[MatlabInterface matlab;
matlab.DLLPath = "C:\Program Files\MATLAB\R2024a\bin\win64"; //This should be where your MATLAB install is located


// Declare variables that will receive MATLAB data
Variable a;
Variable e;
Variable i;
Variable raan;
Variable w;
Variable ta;


// Define Spacecraft Object
Spacecraft sc();

// Create ViewWindow
ViewWindow ViewWindow1({sc});


// Configure MATLAB search path
matlab.NumberAdditionalSearchPaths = 1;
matlab.AdditionalSearchPaths[0] = "C:\Users\gdoh9\Downloads";

// Open the matlabinterface object and call the specifc MATLAB file you are exchanging data with

Open matlab;

// Check connection status
If (matlab.IsOpen == 1);
    Report "Successfully connected to MATLAB!";
End;



//Call the specifc MATLAB file you are exchanging data with in order to retreive the orbit parameters

Call matlab.MATLAB_FF_OrbitProp_Test(a,e,i,raan,w,ta);

// Set initial orbit state (Keplerian elements)
sc.A = a; // semi-major axis in km
sc.E = e; //eccentricity
sc.I = i ; //inclination in degrees
sc.RAAN = raan;//right ascension of ascending node
sc.W = w; //argument of periapsis
sc.TA = ta ; //true anomaly

 
While (sc.ElapsedTime < TIMESPAN(10 hours));
   Step sc;
	Update ViewWindow1;
End;
Update ViewWindow1;

// Close MATLAB connection
Close matlab;
]]></FreeFormScript>
      </FreeForm>
    </ProjectCommands>
  </ProjectMissionSequence>
  <ProjectScript><![CDATA[MatlabInterface matlab;
